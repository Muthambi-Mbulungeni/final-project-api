---
title: Design class diagram 3 - API controllers (Strategies.Api/Controllers)
---
classDiagram
    direction LR

    class AuthController {
        -IAuthService _authService
        -IEmailService _emailService
        -IConfiguration _configuration
        +Login(LoginRequest) Task~IActionResult~
        +Refresh(RevokeTokenRequest) Task~IActionResult~
        +Revoke(RevokeTokenRequest) Task~IActionResult~
        +ForgotPassword(ForgotPasswordRequest) Task~IActionResult~
        +Register(RegisterRequest) Task~IActionResult~
        +ResetPassword(ResetPasswordRequest) Task~IActionResult~
        +Me() Task~IActionResult~
    }
    class LeadsController {
        -ApplicationDbContext _context
        +GetLeads(page, pageSize, search, status) Task~IActionResult~
        +CreateLead(CreateLeadRequest, IAgentService) Task~IActionResult~
        +UpdateLeadStatus(Guid, UpdateLeadStatusRequest) Task~IActionResult~
    }
    class CasesController {
        -ApplicationDbContext _context
        +GetCases(page, pageSize, search, stage) Task~IActionResult~
        +CreateCase(CreateCaseRequest) Task~IActionResult~
        +GetCase(Guid) Task~IActionResult~
        +ExportCases() Task~IActionResult~
        +GetClientCases(Guid, page, pageSize) Task~IActionResult~
        +UpdateStage(Guid, UpdateCaseStageRequest) Task~IActionResult~
        +AssignConsultant(Guid, AssignConsultantRequest) Task~IActionResult~
        -EscapeCsv(string)$ string
    }
    class DocumentsController {
        -ApplicationDbContext _context
        +GetDocuments(caseId, page, pageSize) Task~IActionResult~
        +GetDocument(Guid) Task~IActionResult~
        +DownloadDocument(Guid) Task~IActionResult~
        +UploadDocument(IFormFile) Task~IActionResult~
        +CreateDocument(CreateDocumentRequest) Task~IActionResult~
        +UpdateDocumentStatus(Guid, UpdateDocumentStatusRequest) Task~IActionResult~
        +ArchiveDocument(Guid) Task~IActionResult~
    }
    class AdminController {
        -ApplicationDbContext _context
        +GetUsers(page, pageSize, search) Task~IActionResult~
        +SuspendUser(Guid) Task~IActionResult~
        +ReinstateUser(Guid) Task~IActionResult~
        +DeleteUser(Guid) Task~IActionResult~
        +GetAuditLogs(page, pageSize, userId) Task~IActionResult~
    }
    class StatsController {
        -ApplicationDbContext _context
        +GetAdminStats() Task~IActionResult~
        +GetConsultantStats() Task~IActionResult~
        +GetClientStats(Guid) Task~IActionResult~
    }
    class NotificationController {
        -ApplicationDbContext _context
        +GetNotifications(page, pageSize) Task~IActionResult~
        +MarkAsRead(Guid) Task~IActionResult~
    }
    class DocumentTypesController {
        -ApplicationDbContext _context
        +GetDocumentTypes() Task~IActionResult~
    }

    class IAuthService {
        <<interface>>
    }
    class IEmailService {
        <<interface>>
    }
    class IAgentService {
        <<interface>>
    }
    class ApplicationDbContext {
        <<EF Core DbContext>>
    }

    AuthController --> IAuthService
    AuthController --> IEmailService
    LeadsController ..> IAgentService : FromServices
    LeadsController --> ApplicationDbContext
    CasesController --> ApplicationDbContext
    DocumentsController --> ApplicationDbContext
    AdminController --> ApplicationDbContext
    StatsController --> ApplicationDbContext
    NotificationController --> ApplicationDbContext
    DocumentTypesController --> ApplicationDbContext

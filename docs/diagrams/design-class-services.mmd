---
title: Design class diagram 4 - services and data access (Strategies.Api/Services, Data)
---
classDiagram
    direction TB

    class IAuthService {
        <<interface>>
        +LoginAsync(LoginRequest) Task~AuthResponse?~
        +RefreshTokenAsync(string) Task~AuthResponse?~
        +RevokeTokenAsync(string) Task~bool~
        +GetUserByIdAsync(Guid) Task~User?~
        +GetUserByEmailAsync(string) Task~User?~
        +RegisterAsync(RegisterRequest) Task~bool~
        +ResetPasswordAsync(ResetPasswordRequest) Task~bool~
    }
    class AuthService {
        -ApplicationDbContext _dbContext
        -IPasswordHasherService _passwordHasher
        -ITokenService _tokenService
        -IRefreshTokenStore _refreshTokenStore
        -ILogger _logger
        -Lazy~List~User~~ _lazySeedUsers$
        -IsDbAvailableAsync() Task~bool~
    }
    class ITokenService {
        <<interface>>
        +int AccessTokenExpirationMinutes
        +int RefreshTokenExpirationDays
        +GenerateAccessToken(User) (string, DateTime)
        +GenerateRefreshToken() string
    }
    class TokenService {
        -SymmetricSecurityKey _key
        -string _issuer
        -string _audience
    }
    class IPasswordHasherService {
        <<interface>>
        +HashPassword(string) string
        +VerifyPassword(string, string) bool
    }
    class PasswordHasherService {
        BCrypt, work factor 11
    }
    class IRefreshTokenStore {
        <<interface>>
        +SaveTokenAsync(RefreshToken) Task
        +GetTokenAsync(string) Task~RefreshToken?~
        +RevokeTokenAsync(string, string?) Task
        +RevokeAllUserTokensAsync(Guid) Task
    }
    class InMemoryRefreshTokenStore {
        -ConcurrentDictionary~string, RefreshToken~ _tokens
        -TimeSpan EvictionGracePeriod$
        -EvictStaleTokens() void
    }
    class RefreshToken {
        +string Token
        +Guid UserId
        +DateTime ExpiresAt
        +bool IsRevoked
        +DateTime? RevokedAt
        +string? ReplacedByToken
        +bool IsExpired
        +bool IsActive
    }
    class IEmailService {
        <<interface>>
        +SendPasswordResetEmailAsync(string, string) Task
        +SendAccountConfirmationEmailAsync(string, string) Task
    }
    class SmtpEmailService {
        -IConfiguration _configuration
        -ILogger _logger
        -SendEmailAsync(string, string, string) Task
    }
    class IAgentService {
        <<interface>>
        +ProcessLeadAsync(string) Task~AgentResponse~
    }
    class GeminiAgentService {
        -HttpClient _httpClient
        -IConfiguration _config
        -ILogger _logger
    }
    class CaseManagementService {
        -ApplicationDbContext _context
        +AdvanceCaseStageAsync(Guid) Task~bool~
    }
    class ApplicationDbContext {
        +DbSet~User~ Users
        +DbSet~Lead~ Leads
        +DbSet~Case~ Cases
        +DbSet~Document~ Documents
        +DbSet~AuditLog~ AuditLogs
        +... 7 more DbSets
        #OnModelCreating(ModelBuilder) void
    }
    class DbContext {
        <<EF Core>>
    }

    IAuthService <|.. AuthService
    ITokenService <|.. TokenService
    IPasswordHasherService <|.. PasswordHasherService
    IRefreshTokenStore <|.. InMemoryRefreshTokenStore
    IEmailService <|.. SmtpEmailService
    IAgentService <|.. GeminiAgentService
    DbContext <|-- ApplicationDbContext

    AuthService --> ApplicationDbContext
    AuthService --> IPasswordHasherService
    AuthService --> ITokenService
    AuthService --> IRefreshTokenStore
    InMemoryRefreshTokenStore "1" o-- "0..*" RefreshToken
    CaseManagementService --> ApplicationDbContext

    note for CaseManagementService "Registered in DI and unit tested,<br>but no controller calls it"

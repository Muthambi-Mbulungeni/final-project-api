# Copy this file to .env.local and change values for your machine.
# .env.local is ignored by Git. Never commit real secrets.
# The web portal holds no secrets: API keys (Gemini, JWT, database) live only on the server.

# Where the Vite dev server forwards /api requests.
# Default: the Strategies.Api "http" launch profile.
API_PROXY_TARGET=http://localhost:5151

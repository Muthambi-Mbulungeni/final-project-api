{
  "Jwt": {
    "Issuer": "StrategiesApi",
    "Audience": "StrategiesClients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-3.8-flash-lite"
  },
  "Storage": {
    "UploadsRoot": "wwwroot/uploads"
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Enabled": false
  },
  "RateLimiting": {
    "Leads": {
      "PermitLimit": 5,
      "WindowSeconds": 600
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}